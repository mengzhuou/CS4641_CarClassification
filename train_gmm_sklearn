#!/bin/bash
#SBATCH -J gmm_model
#SBATCH --gres=gpu:1
#SBATCH --mem-per-gpu=32G
#SBATCH -t3:00:00
#SBATCH -oReport-%j.out
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=gcanales6@gatech.edu

module load python/3.10.10

JOB_ID=$SLURM_JOB_ID
TRAIN_DIR="Condensed_Dataset/new_train"
TEST_DIR="Condensed_Dataset/new_test"
MAX_ITERS=10
OUTPUT_DIR="results/gmm_sklearn/model_${JOB_ID}_${MAX_ITERS}-iters"

python gmm_sklearn/gmm_pipeline.py \
  --train_dir $TRAIN_DIR \
  --test_dir $TEST_DIR \
  --output_dir $OUTPUT_DIR \
  --n_components 100 \
  --max_iters $MAX_ITERS \
  --pca_components 50 \
  --cluster_images
