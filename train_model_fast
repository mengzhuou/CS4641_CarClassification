#!/bin/bash
#SBATCH -Jgpuexample
#SBATCH -N1 --gres=gpu:1                       # Number of nodes and GPUs required
#SBATCH --mem-per-gpu=32G                           # Memory per gpu
#SBATCH -t8:00:00                                        # Duration of the job (Ex: 15 mins)
#SBATCH -oReport-%j.out                             # Combined output and error messages file
#SBATCH --mail-type=FAIL                  # Mail preferences
#SBATCH --mail-user=jvarma3@gatech.edu            # e-mail address for notifications

module load tensorflow
JOB_ID=$SLURM_JOB_ID
MODEL_PATH="models/model_$JOB_ID"
RESULT_PATH="results/model_$JOB_ID"

python -m pip install -r requirements.txt 
python resnet_exp.py --model_path $MODEL_PATH --results_path $RESULT_PATH --epochs 10 --steps_per_epoch 10
python analyzing_training.py --results_path $RESULT_PATH/Report-$JOB_ID.out
